font-family = 0xProto Nerd Font Mono
font-family = CodeNewRoman Nerd Font Propo
font-size = 12

background-opacity = 0.85
window-decoration = false

# Alacrittyのカラースキームと同じ (Tokyo Night)
background = 1a1b26
foreground = c0caf5
palette = 0=#15161e
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5

# Ctrl+SpaceをGhosttyが消費しないようにする（macOSのIME切り替えに渡す）
# ignore にしないとターミナルに NUL (^@) が送られて `@` が表示される
keybind = all:ctrl+space=ignore

# Ctrl+JをAquaSKKのかな/英数トグルに渡す（デフォルトでは LF が送られてIMEに届かない）
keybind = all:ctrl+j=ignore

# Shift+Return で § (U+00A7) を送出する (アプリ側で Shift+Return を判別するため，foot.ini 互換)
keybind = shift+enter=text:\xc2\xa7

# theme-toggle が書き出す動的テーマ設定 (存在しない場合は無視される)
config-file = ?theme
